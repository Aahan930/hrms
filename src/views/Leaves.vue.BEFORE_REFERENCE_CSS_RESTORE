  padding: 0 10px;
  border: 1px solid #d7dee8;
  border-radius: 6px;
  outline: none;
  font-size: 9px;
}

.action-search label {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #697586;
  font-size: 8px;
}

.action-search button {
  height: 34px;
  padding: 0 13px;
  border: 1px solid #2874e8;
  border-radius: 6px;
  background: #2874e8;
  color: white;
  font-size: 8px;
  font-weight: 700;
}

.action-search .clear-action {
  border-color: #d7dee8;
  background: white;
  color: #697586;
}

.empty-state {
  padding: 35px;
  text-align: center;
  color: #8a96a8;
  font-size: 10px;
}

.empty-state strong {
  display: block;
  margin-bottom: 5px;
  color: #445168;
}

/* ============================================================
   DIALOG
   ============================================================ */

.dialog-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(20, 30, 48, .42);
}

.dialog {
  position: relative;
  width: min(430px, 100%);
  box-sizing: border-box;
  padding: 22px;
  border-radius: 11px;
  background: white;
  box-shadow: 0 18px 50px rgba(15, 25, 45, .2);
}

.dialog-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 9px;
  background: #edf4ff;
  color: #2874e8;
  font-size: 17px;
}

.dialog-close {
  position: absolute;
  top: 15px;
  right: 15px;
  border: 0;
  background: transparent;
  color: #8792a4;
  font-size: 20px;
  cursor: pointer;
}

.dialog h2 {
  margin: 16px 0 7px;
  color: #29364c;
  font-size: 16px;
}

.dialog > p {
  margin: 0 0 14px;
  color: #7d889a;
  font-size: 9px;
  line-height: 1.5;
}

.dialog-details {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 14px;
  padding: 11px;
  border-radius: 7px;
  background: #f5f7fa;
}

.dialog-details strong {
  color: #39465c;
  font-size: 9px;
}

.dialog-details span {
  color: #8994a6;
  font-size: 8px;
}

.dialog-field {
  display: block;
}

.dialog-field > span {
  display: block;
  margin-bottom: 6px;
  color: #4e5b70;
  font-size: 9px;
  font-weight: 700;
}

.dialog-field textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 9px;
  border: 1px solid #d7dee8;
  border-radius: 6px;
  outline: none;
  resize: vertical;
  font-family: inherit;
  font-size: 9px;
}

.dialog-error {
  margin-top: 10px !important;
  color: #c33f4b !important;
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 17px;
}

.dialog-actions button {
  height: 34px;
  padding: 0 13px;
  border: 1px solid #d7dee8;
  border-radius: 6px;
  background: white;
  color: #697586;
  font-size: 9px;
  font-weight: 700;
}

.dialog-actions .danger-action {
  border-color: #2874e8;
  background: #2874e8;
  color: white;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1100px) {
  .apply-layout {
    grid-template-columns: minmax(0, 1fr) 320px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 850px) {
  .leaves-page {
    padding: 18px;
  }

  .apply-layout {
    grid-template-columns: 1fr;
  }

  .field-grid,
  .duration-row {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .leave-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .tabs {
    width: 100%;
  }

  .tabs button {
    min-width: 0;
    flex: 1;
    padding: 0 8px;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .history-toolbar,
  .action-search {
    align-items: stretch;
    flex-direction: column;
  }
}

