   ============================================================ */

.calendar-header {
  display: grid;
  grid-template-columns: 25px 1fr 25px;
  align-items: center;
  margin: 3px 0 9px;
}

.calendar-header button {
  width: 25px;
  height: 25px;
  border: 0;
  border-radius: 5px;
  background: transparent;
  color: #697586;
  font-size: 16px;
