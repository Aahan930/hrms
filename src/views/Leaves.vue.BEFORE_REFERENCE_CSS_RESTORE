}

.calendar-header strong {
  text-align: center;
  color: #3d495d;
  font-size: 8px;
}

.weekdays,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.weekdays {
  margin-bottom: 5px;
}

.weekdays span {
  color: #929cad;
  font-size: 6px;
  font-weight: 700;
  text-align: center;
}

.calendar-grid {
  row-gap: 3px;
}

.calendar-day {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 23px;
  height: 23px;
  margin: auto;
  border-radius: 6px;
  color: #596579;
  font-size: 7px;
}

.calendar-day.outside {
  color: #d1d6de;
}

.calendar-day.today {
  border: 1px solid #2874e8;
  color: #2874e8;
  font-weight: 800;
}

.calendar-day.selected {
  background: #2874e8;
  color: white;
  font-weight: 800;
}

.calendar-legend {
  display: flex;
  gap: 12px;
  margin-top: 9px;
  padding-top: 8px;
  border-top: 1px solid #edf0f4;
  color: #929cad;
  font-size: 6px;
}

.calendar-legend span {
  display: flex;
  align-items: center;
  gap: 4px;
}

.calendar-legend i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.leave-dot {
  background: #2874e8;
}

.weekend-dot {
  background: #e8edf3;
}

/* ============================================================
   SECONDARY PAGES
   ============================================================ */

.secondary-page {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.stat-card,
.history-card,
.action-card,
.large-balance-card {
  border: 1px solid #e0e6ef;
  border-radius: 9px;
  background: white;
